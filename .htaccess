RewriteEngine On

# Interdit l'accès direct au code, à la configuration et au schéma SQL
RewriteRule ^(config|controllers|models|views|inc|storage|node_modules)(/|$) - [F,L]
RewriteRule \.(sql|md|lock)$ - [F,L]
RewriteRule (^|/)\. - [F,L]

# Toutes les autres URL passent par le routeur index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?page=$1 [QSA,L]

Options -Indexes
